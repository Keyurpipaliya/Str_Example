#check whether the string is "Hello"

text = input("Enter a string: ")

if text == "Hello":
    print("String is Hello")
else:
    print("String is not Hello")

String is not Hello

#Check whether a string is empty

text = input("Enter a string: ")

if text == "":
    print("String is empty")
else:
    print("String is not empty")

String is not empty

#Check string length

text = input("Enter a string: ")

if len(text) >= 5:
    print("String has 5 or more characters")
else:
    print("String has less than 5 characters")

String has 5 or more characters

#Check whether a string starts with "A"

text = input("Enter a string: ")

if text.endswith("ing"):
    print("String ends with ing")
else:
    print("String does not end with ing")

String does not end with ing

#Check whether a word is present

text = input("Enter a sentence: ")

if "python" in text.lower():
    print("Python is present")
else:
    print("Python is not present")

Python is present

# Check uppercase or lowercase

text = input("Enter a string: ")

if text.isupper():
    print("String is in uppercase")
else:
    print("String is not completely uppercase")

String is in uppercase

